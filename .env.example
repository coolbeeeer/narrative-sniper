# Narrative Sniper - Environment Configuration
# Copy this to .env and fill in your API keys

# Database (Aiven PostgreSQL) - Replace with your connection string
DATABASE_URL=postgres://user:password@host:port/database?sslmode=require

# Redis (Upstash) - Replace with your connection string
REDIS_URL=rediss://default:password@host:port

# Twitter API v2
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Discord Bot
DISCORD_BOT_TOKEN=

# Helius (Solana RPC)
HELIUS_API_KEY=

# Jupiter (Swap Aggregator)
JUPITER_API_KEY=

# Jito (MEV Protection)
JITO_API_KEY=

# LLM Providers (at least one required for narrative labeling)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Backend Settings
SECRET_KEY=your-secret-key-change-in-production
PAPER_TRADING=true
MAX_POSITION_SIZE_USD=1000
MAX_DAILY_LOSS_USD=500
SLIPPAGE_BPS=100
PRIORITY_FEE_LAMPORTS=10000
NARRATIVE_CONFIDENCE_THRESHOLD=0.6