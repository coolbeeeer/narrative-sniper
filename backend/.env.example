# Narrative Sniper Backend Configuration

# App
APP_NAME=Narrative Sniper
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database - Replace with your connection string
DATABASE_URL=postgresql://postgres:***@localhost:5432/narrative_sniper
REDIS_URL=redis://localhost:6379

# Twitter API (v2)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Discord
DISCORD_BOT_TOKEN=

# Helius (Solana RPC)
HELIUS_API_KEY=
HELIUS_WS_URL=wss://mainnet.helius-rpc.com

# Jupiter (Swap)
JUPITER_API_KEY=
JUPITER_API_URL=https://quote-api.jup.ag/v6

# Jito (MEV Protection)
JITO_API_KEY=
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf

# LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Auth
SECRET_KEY=dev-secret-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Ingestion
INGESTION_BATCH_SIZE=100
INGESTION_INTERVAL_SECONDS=60
MAX_CONCURRENT_INGESTIONS=10

# Intelligence
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CLUSTER_MIN_SIZE=5
CLUSTER_MIN_SAMPLES=3
NARRATIVE_CONFIDENCE_THRESHOLD=0.6

# Execution
PAPER_TRADING=true
MAX_POSITION_SIZE_USD=1000.0
MAX_DAILY_LOSS_USD=500.0
SLIPPAGE_BPS=100
PRIORITY_FEE_LAMPORTS=10000

# Monitoring
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO